generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  USER
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  password   String
  role       Role     @default(USER)
  first_name String?
  last_name  String?
  phone      String?
  subject    String?
  avatar_url String?
  login_type String?  @default("email")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  announcements Announcements[]
  enrollments   Enrollments[]
  resources     Resources[]
  siteContent   SiteContent[]
  testAttempts  TestAttempts[]
  tests         Tests[]
  notebooks     Notebooks[]
  questionTags  QuestionTags[]
  bookmarks     Bookmarks[]

  @@map("users")
}

model Streams {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  batches Batches[]

  @@map("streams")
}

model Batches {
  id               String    @id
  stream_id        String?   @db.Uuid
  title            String
  subtitle         String?
  description      String?
  class_name       String?
  target_year      String?
  duration         String?
  price            String?
  registration_fee String?
  batch_date       DateTime? @db.Date
  end_date         DateTime? @db.Date
  syllabus_url     String?
  image_url        String?
  color_theme      String?
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  stream        Streams?        @relation(fields: [stream_id], references: [id])
  announcements Announcements[]
  chapters      Chapters[]
  enrollments   Enrollments[]
  resources     Resources[]
  subjects      Subjects[]
  tests         Tests[]
  timetable     Timetable[]

  @@map("batches")
}

model Subjects {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id    String?
  name        String
  order_index Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  batch     Batches?    @relation(fields: [batch_id], references: [id])
  chapters  Chapters[]
  resources Resources[]

  @@map("subjects")
}

model Chapters {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_id     String?   @db.Uuid
  batch_id       String?
  title          String
  chapter_number Int
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  subject   Subjects?   @relation(fields: [subject_id], references: [id])
  batch     Batches?    @relation(fields: [batch_id], references: [id])
  resources Resources[]

  @@map("chapters")
}

model Enrollments {
  user_id     String    @db.Uuid
  batch_id    String
  enrolled_at DateTime? @default(now()) @db.Timestamptz(6)

  user  User    @relation(fields: [user_id], references: [id])
  batch Batches @relation(fields: [batch_id], references: [id])

  @@id([user_id, batch_id])
  @@map("enrollments")
}

model Freebies {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  subject    String
  type       String
  file_url   String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("freebies")
}

model Inquiries {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String?
  phone          String
  message        String?
  batch_interest String?
  status         String?   @default("pending")
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@map("inquiries")
}

model Resources {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id    String?
  subject_id  String?   @db.Uuid
  chapter_id  String?   @db.Uuid
  title       String
  type        String
  file_url    String
  file_size   BigInt?
  uploaded_by String?   @db.Uuid
  is_free     Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  batch   Batches?  @relation(fields: [batch_id], references: [id])
  subject Subjects? @relation(fields: [subject_id], references: [id])
  chapter Chapters? @relation(fields: [chapter_id], references: [id])
  user    User?     @relation(fields: [uploaded_by], references: [id])

  @@map("resources")
}

model SiteContent {
  key        String    @id
  value      Json?     @default("[]")
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_by String?   @db.Uuid

  user User? @relation(fields: [updated_by], references: [id])

  @@map("site_content")
}

model Tests {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id         String?
  name             String
  config           Json?     @default("{}")
  schedule         Json?     @default("{}")
  questions        Json?     @default("[]")
  duration_minutes Int?      @default(180)
  created_by       String?   @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  tags             String[]
  answer_key       Json?     @default("{}")
  is_free          Boolean?  @default(false)
  test_type        String?   @default("FULL_SYLLABUS")

  batch        Batches?       @relation(fields: [batch_id], references: [id])
  user         User?          @relation(fields: [created_by], references: [id])
  testAttempts TestAttempts[]
  bookmarks    Bookmarks[]

  @@map("tests")
}

model TestAttempts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  test_id        String    @db.Uuid
  student_id     String    @db.Uuid
  student_name   String?
  score          Int?      @default(0)
  max_score      Int?      @default(0)
  accuracy       Decimal?  @default(0) @db.Decimal
  time_taken     Int?      @default(0)
  answers        Json?     @default("{}")
  status         Json?     @default("{}")
  time_spent     Json?     @default("{}")
  question_keys  Json?     @default("{}")
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  subject_scores Json?     @default("{}")
  is_submitted   Boolean?  @default(true)

  test Tests @relation(fields: [test_id], references: [id])
  user User? @relation(fields: [student_id], references: [id])

  @@map("test_attempts")
}

model Timetable {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id      String?
  day_of_week   Int?
  start_time    DateTime  @db.Time
  end_time      DateTime  @db.Time
  subject       String?
  topic         String?
  faculty       String?
  date          DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  is_compulsory Boolean?  @default(true)

  batch Batches? @relation(fields: [batch_id], references: [id])

  @@map("timetable")
}

model Announcements {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id     String?
  title        String
  message      String
  author_id    String?   @db.Uuid
  is_important Boolean?  @default(false)
  tags         String[]
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  batch Batches? @relation(fields: [batch_id], references: [id])
  user  User?    @relation(fields: [author_id], references: [id])

  @@map("announcements")
}

// -----------------------------------------------------
// NEW DOMAIN MODELS (Synchronized from Supabase Schema)
// -----------------------------------------------------

model Blogs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String    @unique
  title         String
  excerpt       String?
  cover_image   String?
  category      String
  author_name   String
  author_avatar String?
  published_at  DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  read_time     String?
  sections      Json?     @default("[]")
  tags          String[]
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("blogs")
}

model Results {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  image_url       String?
  rank            String?
  score           String?
  exam_type       String
  batch_name      String?
  year            String?
  is_hall_of_fame Boolean?  @default(false)
  result_type     String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@map("results")
}

model Notebooks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  user_id     String    @db.Uuid
  title       String
  description String?

  user      User        @relation(fields: [user_id], references: [id])
  bookmarks Bookmarks[]

  @@map("notebooks")
}

model QuestionTags {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  user_id     String    @db.Uuid
  name        String
  color       String?   @default("#3b82f6")

  user                 User                   @relation(fields: [user_id], references: [id])
  bookmarkTagRelations BookmarkTagRelations[]

  @@map("question_tags")
}

model Bookmarks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  user_id     String    @db.Uuid
  notebook_id String    @db.Uuid
  test_id     String    @db.Uuid
  question_id String
  notes       String?

  user                 User                   @relation(fields: [user_id], references: [id])
  test                 Tests                  @relation(fields: [test_id], references: [id])
  notebook             Notebooks              @relation(fields: [notebook_id], references: [id])
  bookmarkTagRelations BookmarkTagRelations[]

  @@map("bookmarks")
}

model BookmarkTagRelations {
  bookmark_id String    @db.Uuid
  tag_id      String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  bookmark Bookmarks    @relation(fields: [bookmark_id], references: [id])
  tag      QuestionTags @relation(fields: [tag_id], references: [id])

  @@id([bookmark_id, tag_id])
  @@map("bookmark_tag_relations")
}
